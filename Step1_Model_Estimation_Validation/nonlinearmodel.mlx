%% QUBE-SERVO 3 - Final Nonlinear Identification Model
% Multi-file automatic parameter estimation
% States: x = [theta; theta_dot; alpha; alpha_dot]

clear; clc; close all;

%% ============================================================
% 1) FILES
% ============================================================
files = {
    '/Users/felixmogensen/Documents/SDU/4sem/Semesterprojekt - anden omgang/FinalNonlineramodel/qube_step_test_1.csv'
    '/Users/felixmogensen/Documents/SDU/4sem/Semesterprojekt - anden omgang/FinalNonlineramodel/qube_step_test_2.csv'
    '/Users/felixmogensen/Documents/SDU/4sem/Semesterprojekt - anden omgang/FinalNonlineramodel/qube_step_test_5.csv'
};


meas = cell(length(files),1);

for i = 1:length(files)
    data = readtable(files{i});

    m.t         = data.t;
    m.u         = data.u;
    m.theta     = data.theta;
    m.theta_dot = data.theta_dot;
    m.alpha     = data.alpha;
    m.alpha_dot = data.alpha_dot;

    % Alpha reference correction
    m.alpha     = pi - m.alpha;
    m.alpha_dot = -m.alpha_dot;

    

    m.file = files{i};
    meas{i} = m;
end

%% ============================================================
% 2) KNOWN PARAMETERS FROM DATASHEET
% ============================================================
p.g  = 9.81;

% Motor
p.Rm = 7.5;
p.kt = 0.0422;
p.km = 0.0422;
p.Jm = 1.4e-6;

% Hub
p.mh = 0.0106;
p.rh = 0.0111;
p.Jh = 0.6e-6;

% Disc
p.md = 0.053;
p.rd = 0.0248;

% Rotary arm + pendulum
p.mr = 0.095;
p.Lr = 0.085;
p.mp = 0.024;
p.Lp = 0.129;

%% ============================================================
% 3) DERIVED INERTIAS
% ============================================================
p.Jd      = 0.5 * p.md * p.rd^2;
p.Jr_arm  = (1/3) * p.mr * p.Lr^2;
p.Jr_base = p.Jm + p.Jh + p.Jd + p.Jr_arm;
p.Jp_base = (1/12) * p.mp * p.Lp^2;

%% ============================================================
% 4) FIXED PARAMETERS
% ============================================================
p.Jr_extra = 0;
p.Fc_r = 0;
p.Fc_p = 0;
p.eta_m = 1.0;
p.deadzone = 0.25;
p.Vmax = 10.0;

%% ============================================================
% 5) INITIAL GUESS
% q = [Jp_scale, Br, Bp, Kg, eta_g, Kc]
% ============================================================
q0 = [
    0.31;      % Jp_scale
    1.23e-4;   % Br
    2.07e-4;   % Bp
    2.42;      % Kg
    0.99;      % eta_g
    2.87e-3    % Kc
];

%% ============================================================
% 6) AUTOMATIC OPTIMIZATION
% ============================================================
fprintf('\nStarting automatic parameter estimation using %d files...\n', length(files));

options = optimset( ...
    'Display','iter', ...
    'MaxIter',500, ...
    'MaxFunEvals',1500, ...
    'TolX',1e-6, ...
    'TolFun',1e-6);

cost_fun = @(q) qube_multi_cost_function(q, p, meas);

warnState = warning('off','all');
q_opt = fminsearch(cost_fun, q0, options);
warning(warnState);

%% ============================================================
% 7) APPLY OPTIMIZED PARAMETERS
% ============================================================
p.Jp_scale = q_opt(1);
p.Br       = q_opt(2);
p.Bp       = q_opt(3);
p.Kg       = q_opt(4);
p.eta_g    = q_opt(5);
p.Kc       = q_opt(6);

p.Jr = p.Jr_base + p.Jr_extra;
p.Jp = p.Jp_scale * p.Jp_base;

fprintf('\n================ OPTIMIZED PARAMETERS ================\n');
fprintf('Jp_scale = %.6f\n', p.Jp_scale);
fprintf('Br       = %.6e N*m*s/rad\n', p.Br);
fprintf('Bp       = %.6e N*m*s/rad\n', p.Bp);
fprintf('Kg       = %.6f\n', p.Kg);
fprintf('eta_g    = %.6f\n', p.eta_g);
fprintf('eta_m    = %.6f\n', p.eta_m);
fprintf('deadzone = %.6f V\n', p.deadzone);
fprintf('Kc       = %.6e N*m/rad\n', p.Kc);

%% ============================================================
% 8) SIMULATE, CALCULATE ERRORS, AND PLOT EACH FILE
% ============================================================
n_theta     = zeros(length(meas),1);
n_alpha     = zeros(length(meas),1);
n_theta_dot = zeros(length(meas),1);
n_alpha_dot = zeros(length(meas),1);

% Use first file time vector as reference for combined plots
t_ref = meas{1}.t;

theta_all         = zeros(length(t_ref), length(meas));
theta_sim_all     = zeros(length(t_ref), length(meas));
alpha_all         = zeros(length(t_ref), length(meas));
alpha_sim_all     = zeros(length(t_ref), length(meas));
theta_dot_all     = zeros(length(t_ref), length(meas));
theta_dot_sim_all = zeros(length(t_ref), length(meas));
alpha_dot_all     = zeros(length(t_ref), length(meas));
alpha_dot_sim_all = zeros(length(t_ref), length(meas));

for i = 1:length(meas)
    m = meas{i};
    u_fun = @(tt) interp1(m.t, m.u, tt, 'previous', 0);

    x0 = [
        m.theta(1);
        m.theta_dot(1);
        m.alpha(1);
        m.alpha_dot(1)
    ];

    tspan = [m.t(1), m.t(end)];
    opts  = odeset('RelTol',1e-6,'AbsTol',1e-8);

    [t_sim, x_sim] = ode45(@(t,x) qube_model_eom(t, x, p, u_fun), tspan, x0, opts);

    theta_sim_i     = interp1(t_sim, x_sim(:,1), m.t, 'linear', 'extrap');
    theta_dot_sim_i = interp1(t_sim, x_sim(:,2), m.t, 'linear', 'extrap');
    alpha_sim_i     = interp1(t_sim, x_sim(:,3), m.t, 'linear', 'extrap');
    alpha_dot_sim_i = interp1(t_sim, x_sim(:,4), m.t, 'linear', 'extrap');

    [rmse, nrmse] = compute_errors(m, theta_sim_i, theta_dot_sim_i, alpha_sim_i, alpha_dot_sim_i);

    n_theta(i)     = nrmse.theta;
    n_alpha(i)     = nrmse.alpha;
    n_theta_dot(i) = nrmse.theta_dot;
    n_alpha_dot(i) = nrmse.alpha_dot;

    fprintf('\n================ FILE %d RESULTS ================\n', i);
    fprintf('File: %s\n', m.file);
    fprintf('NRMSE theta      = %.2f%%\n', 100*nrmse.theta);
    fprintf('NRMSE alpha      = %.2f%%\n', 100*nrmse.alpha);
    fprintf('NRMSE theta_dot  = %.2f%%\n', 100*nrmse.theta_dot);
    fprintf('NRMSE alpha_dot  = %.2f%%\n', 100*nrmse.alpha_dot);

    % Store for combined/average plots
    theta_all(:,i)         = interp1(m.t, m.theta,         t_ref, 'linear', 'extrap');
    theta_sim_all(:,i)     = interp1(m.t, theta_sim_i,     t_ref, 'linear', 'extrap');
    alpha_all(:,i)         = interp1(m.t, m.alpha,         t_ref, 'linear', 'extrap');
    alpha_sim_all(:,i)     = interp1(m.t, alpha_sim_i,     t_ref, 'linear', 'extrap');
    theta_dot_all(:,i)     = interp1(m.t, m.theta_dot,     t_ref, 'linear', 'extrap');
    theta_dot_sim_all(:,i) = interp1(m.t, theta_dot_sim_i, t_ref, 'linear', 'extrap');
    alpha_dot_all(:,i)     = interp1(m.t, m.alpha_dot,     t_ref, 'linear', 'extrap');
    alpha_dot_sim_all(:,i) = interp1(m.t, alpha_dot_sim_i, t_ref, 'linear', 'extrap');

    % Plot each file
    figure('Name',['QUBE File ', num2str(i)], 'Color','w');

    subplot(4,1,1)
    plot(m.t, m.u, 'k', 'LineWidth', 1.5)
    grid on
    ylabel('u (V)')
    title(['Input - File ', num2str(i)])

    subplot(4,1,2)
    plot(m.t, m.theta, 'b', 'LineWidth', 1.5); hold on
    plot(m.t, theta_sim_i, 'r--', 'LineWidth', 1.5)
    grid on
    ylabel('\theta (rad)')
    title('Arm angle')
    legend('Measured','Simulated')

    subplot(4,1,3)
    plot(m.t, m.alpha, 'b', 'LineWidth', 1.5); hold on
    plot(m.t, alpha_sim_i, 'r--', 'LineWidth', 1.5)
    grid on
    ylabel('\alpha (rad)')
    title('Pendulum angle')
    legend('Measured','Simulated')

    subplot(4,1,4)
    plot(m.t, m.theta_dot, 'b', 'LineWidth', 1.2); hold on
    plot(m.t, theta_dot_sim_i, 'b--', 'LineWidth', 1.2)
    plot(m.t, m.alpha_dot, 'r', 'LineWidth', 1.2)
    plot(m.t, alpha_dot_sim_i, 'r--', 'LineWidth', 1.2)
    grid on
    ylabel('rad/s')
    xlabel('Time (s)')
    title('Velocities')
    legend('\theta dot','\theta dot sim','\alpha dot','\alpha dot sim')
end

%% ============================================================
% 9) AVERAGE ERROR RESULTS
% ============================================================
mean_theta     = mean(n_theta);
mean_alpha     = mean(n_alpha);
mean_theta_dot = mean(n_theta_dot);
mean_alpha_dot = mean(n_alpha_dot);

fprintf('\n============= AVERAGE NRMSE RESULTS =============\n');
fprintf('Average NRMSE theta      = %.2f%%\n', 100*mean_theta);
fprintf('Average NRMSE alpha      = %.2f%%\n', 100*mean_alpha);
fprintf('Average NRMSE theta_dot  = %.2f%%\n', 100*mean_theta_dot);
fprintf('Average NRMSE alpha_dot  = %.2f%%\n', 100*mean_alpha_dot);

results_table = table( ...
    (1:length(meas))', ...
    100*n_theta, ...
    100*n_alpha, ...
    100*n_theta_dot, ...
    100*n_alpha_dot, ...
    'VariableNames', {'File','Theta_NRMSE_percent','Alpha_NRMSE_percent','ThetaDot_NRMSE_percent','AlphaDot_NRMSE_percent'} ...
);

average_row = table( ...
    0, ...
    100*mean_theta, ...
    100*mean_alpha, ...
    100*mean_theta_dot, ...
    100*mean_alpha_dot, ...
    'VariableNames', results_table.Properties.VariableNames ...
);

results_table = [results_table; average_row];
disp(results_table)

%% ============================================================
% 10) COMBINED PLOT: ALL FILES TOGETHER
% ============================================================
figure('Name','All files combined','Color','w');

subplot(4,1,1)
plot(t_ref, theta_all, 'LineWidth', 1.2); hold on
plot(t_ref, theta_sim_all, '--', 'LineWidth', 1.2)
grid on
ylabel('\theta (rad)')
title('Arm angle - all files')
legend('Meas 1','Meas 2','Meas 3','Sim 1','Sim 2','Sim 3')

subplot(4,1,2)
plot(t_ref, alpha_all, 'LineWidth', 1.2); hold on
plot(t_ref, alpha_sim_all, '--', 'LineWidth', 1.2)
grid on
ylabel('\alpha (rad)')
title('Pendulum angle - all files')
legend('Meas 1','Meas 2','Meas 3','Sim 1','Sim 2','Sim 3')

subplot(4,1,3)
plot(t_ref, theta_dot_all, 'LineWidth', 1.2); hold on
plot(t_ref, theta_dot_sim_all, '--', 'LineWidth', 1.2)
grid on
ylabel('\theta dot (rad/s)')
title('Arm velocity - all files')
legend('Meas 1','Meas 2','Meas 3','Sim 1','Sim 2','Sim 3')

subplot(4,1,4)
plot(t_ref, alpha_dot_all, 'LineWidth', 1.2); hold on
plot(t_ref, alpha_dot_sim_all, '--', 'LineWidth', 1.2)
grid on
ylabel('\alpha dot (rad/s)')
xlabel('Time (s)')
title('Pendulum velocity - all files')
legend('Meas 1','Meas 2','Meas 3','Sim 1','Sim 2','Sim 3')

%% ============================================================
% 11) AVERAGE MEASURED VS SIMULATED PLOT
% ============================================================
theta_mean         = mean(theta_all, 2);
theta_sim_mean     = mean(theta_sim_all, 2);
alpha_mean         = mean(alpha_all, 2);
alpha_sim_mean     = mean(alpha_sim_all, 2);
theta_dot_mean     = mean(theta_dot_all, 2);
theta_dot_sim_mean = mean(theta_dot_sim_all, 2);
alpha_dot_mean     = mean(alpha_dot_all, 2);
alpha_dot_sim_mean = mean(alpha_dot_sim_all, 2);

figure('Name','Average measured vs simulated','Color','w');

subplot(4,1,1)
plot(t_ref, theta_mean, 'b', 'LineWidth', 1.6); hold on
plot(t_ref, theta_sim_mean, 'r--', 'LineWidth', 1.6)
grid on
ylabel('\theta (rad)')
title('Average arm angle')
legend('Measured average','Simulated average')

subplot(4,1,2)
plot(t_ref, alpha_mean, 'b', 'LineWidth', 1.6); hold on
plot(t_ref, alpha_sim_mean, 'r--', 'LineWidth', 1.6)
grid on
ylabel('\alpha (rad)')
title('Average pendulum angle')
legend('Measured average','Simulated average')

subplot(4,1,3)
plot(t_ref, theta_dot_mean, 'b', 'LineWidth', 1.6); hold on
plot(t_ref, theta_dot_sim_mean, 'r--', 'LineWidth', 1.6)
grid on
ylabel('\theta dot (rad/s)')
title('Average arm velocity')
legend('Measured average','Simulated average')

subplot(4,1,4)
plot(t_ref, alpha_dot_mean, 'b', 'LineWidth', 1.6); hold on
plot(t_ref, alpha_dot_sim_mean, 'r--', 'LineWidth', 1.6)
grid on
ylabel('\alpha dot (rad/s)')
xlabel('Time (s)')
title('Average pendulum velocity')
legend('Measured average','Simulated average')

%% ============================================================
% LOCAL FUNCTIONS
% ============================================================

function J = qube_multi_cost_function(q, p, meas)

    p.Jp_scale = q(1);
    p.Br       = q(2);
    p.Bp       = q(3);
    p.Kg       = q(4);
    p.eta_g    = q(5);
    p.Kc       = q(6);

    % Physical bounds
    if p.Jp_scale < 0.1 || p.Jp_scale > 3.0 || ...
       p.Br < 0 || p.Br > 5e-3 || ...
       p.Bp < 0 || p.Bp > 5e-3 || ...
       p.Kg < 1.0 || p.Kg > 8.0 || ...
       p.eta_g < 0.1 || p.eta_g > 1.0 || ...
       p.Kc < 0 || p.Kc > 0.02

        J = 1e6;
        return;
    end

    p.Jr = p.Jr_base + p.Jr_extra;
    p.Jp = p.Jp_scale * p.Jp_base;

    total_cost = 0;

    for i = 1:length(meas)
        m = meas{i};
        u_fun = @(tt) interp1(m.t, m.u, tt, 'previous', 0);

        x0 = [
            m.theta(1);
            m.theta_dot(1);
            m.alpha(1);
            m.alpha_dot(1)
        ];

        tspan = [m.t(1), m.t(end)];
        opts  = odeset('RelTol',1e-5,'AbsTol',1e-7);

        try
            [t_sim, x_sim] = ode45(@(t,x) qube_model_eom(t, x, p, u_fun), tspan, x0, opts);

            theta_sim     = interp1(t_sim, x_sim(:,1), m.t, 'linear', 'extrap');
            theta_dot_sim = interp1(t_sim, x_sim(:,2), m.t, 'linear', 'extrap');
            alpha_sim     = interp1(t_sim, x_sim(:,3), m.t, 'linear', 'extrap');
            alpha_dot_sim = interp1(t_sim, x_sim(:,4), m.t, 'linear', 'extrap');

            [~, nrmse] = compute_errors(m, theta_sim, theta_dot_sim, alpha_sim, alpha_dot_sim);

            file_cost = 2.0*nrmse.theta + ...
                        3.0*nrmse.alpha + ...
                        0.5*nrmse.theta_dot + ...
                        0.5*nrmse.alpha_dot;

            total_cost = total_cost + file_cost;

        catch
            J = 1e6;
            return;
        end
    end

    J = total_cost / length(meas);

    if isnan(J) || isinf(J)
        J = 1e6;
    end
end

function [rmse, nrmse] = compute_errors(m, theta_sim, theta_dot_sim, alpha_sim, alpha_dot_sim)

    theta_err     = m.theta     - theta_sim;
    alpha_err     = m.alpha     - alpha_sim;
    theta_dot_err = m.theta_dot - theta_dot_sim;
    alpha_dot_err = m.alpha_dot - alpha_dot_sim;

    rmse.theta     = sqrt(mean(theta_err.^2));
    rmse.alpha     = sqrt(mean(alpha_err.^2));
    rmse.theta_dot = sqrt(mean(theta_dot_err.^2));
    rmse.alpha_dot = sqrt(mean(alpha_dot_err.^2));

    range_theta     = max(m.theta)     - min(m.theta);
    range_alpha     = max(m.alpha)     - min(m.alpha);
    range_theta_dot = max(m.theta_dot) - min(m.theta_dot);
    range_alpha_dot = max(m.alpha_dot) - min(m.alpha_dot);

    range_theta     = max(range_theta, eps);
    range_alpha     = max(range_alpha, eps);
    range_theta_dot = max(range_theta_dot, eps);
    range_alpha_dot = max(range_alpha_dot, eps);

    nrmse.theta     = rmse.theta     / range_theta;
    nrmse.alpha     = rmse.alpha     / range_alpha;
    nrmse.theta_dot = rmse.theta_dot / range_theta_dot;
    nrmse.alpha_dot = rmse.alpha_dot / range_alpha_dot;
end

function dx = qube_model_eom(t, x, p, u_fun)

    theta     = x(1);
    theta_dot = x(2);
    alpha     = x(3);
    alpha_dot = x(4);

    Vm = u_fun(t);
    Vm = max(min(Vm, p.Vmax), -p.Vmax);

    if abs(Vm) < p.deadzone
        Vm_eff = 0;
    else
        Vm_eff = sign(Vm) * (abs(Vm) - p.deadzone);
    end

    tau = (p.eta_g * p.Kg * p.eta_m * p.kt * ...
          (Vm_eff - p.Kg * p.km * theta_dot)) / p.Rm;

    tau_cable = -p.Kc * theta;

    tau_f_theta = p.Br * theta_dot + p.Fc_r * tanh(100 * theta_dot);
    tau_f_alpha = p.Bp * alpha_dot + p.Fc_p * tanh(100 * alpha_dot);

    A11 = p.mp * p.Lr^2 ...
        + 0.25 * p.mp * p.Lp^2 ...
        - 0.25 * p.mp * p.Lp^2 * cos(alpha)^2 ...
        + p.Jr;

    A12 = -0.5 * p.mp * p.Lp * p.Lr * cos(alpha);
    A21 = A12;

    A22 = p.Jp + 0.25 * p.mp * p.Lp^2;

    N1 = 0.5 * p.mp * p.Lp^2 * sin(alpha) * cos(alpha) * theta_dot * alpha_dot ...
       + 0.5 * p.mp * p.Lp * p.Lr * sin(alpha) * alpha_dot^2;

    N2_theta = 0.25 * p.mp * p.Lp^2 * cos(alpha) * sin(alpha) * theta_dot^2;
    N2_grav  = 0.5  * p.mp * p.Lp * p.g * sin(alpha);

    rhs1 = tau + tau_cable - tau_f_theta - N1;
    rhs2 = -tau_f_alpha + N2_theta + N2_grav;

    M = [A11, A12;
         A21, A22];

    qdd = M \ [rhs1; rhs2];

    dx = [
        theta_dot;
        qdd(1);
        alpha_dot;
        qdd(2)
    ];
end

